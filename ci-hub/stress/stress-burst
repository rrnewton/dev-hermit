#!/usr/bin/env bash
# stress-burst — shared concurrent-BURST determinism-stress primitive.
#
# ONE primitive, co-owned by the nightly stress harness (ci-hub/stress/) and the
# multisect bisection driver. It runs a flaky-prone Rust test W times concurrently
# under real host load, each instance timeout-wrapped, classifies each per-instance
# outcome {pass=exit0, hang=exit124, other}, and emits the shared CSV contract:
#
#     sha,short,build_s,burst_N,hangs,passes,other,hang_rate,STATUS
#     STATUS: OK | WT_FAIL | BUILD_FAIL | NOBIN | NOTEST   (non-OK = harness error)
#
# It is a generalization of experiments/multisect_detcore_misc_20260803/probe.sh
# (same burst loop, same trinary classification, same CSV) with two build modes so
# nightly (main HEAD) and multisect (per-SHA bisection) share code WITHOUT sharing
# a worktree — the collision that blocked reuse:
#
#   --prebuilt DIR   burst the test binary already built in DIR/target (no build).
#                    Used by nightly against the primary checkout at main HEAD.
#   --build-at SHA   git-worktree build at SHA under --wt-base (default isolated),
#                    reflink-seeding target/ once. Used by multisect per commit.
#
# Both tools read the SAME k/N two ways (nightly: flaky-is-red; multisect: rate
# bands), so they can never drift on how flakiness is MEASURED.
#
# Usage:
#   stress-burst --prebuilt DIR      --workload BIN:TEST::PATH [--width W] [--timeout S] [--out CSV]
#   stress-burst --build-at SHA      --workload BIN:TEST::PATH [--width W] [--timeout S]
#                [--hermit DIR] [--wt-base DIR] [--out CSV]
#
#   --workload   BIN:TESTPATH, e.g. tests_misc:vfork::vfork_parent_resumes_after_child_exec
#                BIN is the cargo test-binary name; TESTPATH is the --exact test path.
set -uo pipefail

WIDTH=64; TIMEOUT=20; MODE=""; ARG=""; WORKLOAD=""; OUT=""
HERMIT=""; WT_BASE=""
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_HERMIT="$(cd "$SELF/.." && pwd)/hermit"

die() { echo "stress-burst: $*" >&2; exit 2; }
while [ $# -gt 0 ]; do
  case "$1" in
    --prebuilt) MODE=prebuilt; ARG="$2"; shift 2;;
    --build-at) MODE=build;    ARG="$2"; shift 2;;
    --workload) WORKLOAD="$2"; shift 2;;
    --width)    WIDTH="$2";    shift 2;;
    --timeout)  TIMEOUT="$2";  shift 2;;
    --hermit)   HERMIT="$2";   shift 2;;
    --wt-base)  WT_BASE="$2";  shift 2;;
    --out)      OUT="$2";      shift 2;;
    -h|--help)  sed -n '2,40p' "$0"; exit 0;;
    *) die "unknown arg: $1";;
  esac
done
[ -n "$MODE" ] || die "one of --prebuilt DIR / --build-at SHA required"
[ -n "$WORKLOAD" ] || die "--workload BIN:TESTPATH required"
HERMIT="${HERMIT:-$DEFAULT_HERMIT}"
BIN_NAME="${WORKLOAD%%:*}"; TEST_PATH="${WORKLOAD#*:}"
[ "$BIN_NAME" != "$WORKLOAD" ] || die "workload must be BIN:TESTPATH"

emit() { if [ -n "$OUT" ]; then echo "$1" >>"$OUT"; else echo "$1"; fi; }
detcore_package_name() {
  grep -m1 -E '^name = "(hermit-)?detcore"$' "$1/detcore/Cargo.toml" |
    cut -d '"' -f 2
}

# --- resolve the checkout + test binary --------------------------------------
BUILD_S=0
if [ "$MODE" = prebuilt ]; then
  CO="$ARG"
  [ -d "$CO" ] || die "--prebuilt dir not found: $CO"
  SHA="$(git -C "$CO" rev-parse HEAD 2>/dev/null || echo unknown)"
else
  # build-at SHA: relocatable worktree so we never touch anyone else's wt dir.
  SHA_REQ="$ARG"
  WT_BASE="${WT_BASE:-$SELF/ignored/stress-wt}"
  CO="$WT_BASE/$SHA_REQ"
  mkdir -p "$WT_BASE"
  if [ ! -d "$CO" ]; then
    git -C "$HERMIT" worktree add --detach "$CO" "$SHA_REQ" >/dev/null 2>&1 \
      || { emit "$SHA_REQ,,,,,,,,WT_FAIL"; exit 0; }
  fi
  [ ! -d "$CO/target" ] && cp -a --reflink=auto "$HERMIT/target" "$CO/target" 2>/dev/null
  SHA="$(git -C "$CO" rev-parse HEAD 2>/dev/null || echo "$SHA_REQ")"
  bstart=$(date +%s)
  DETCOR_PACKAGE="$(detcore_package_name "$CO")"
  case "$DETCOR_PACKAGE" in
    detcore | hermit-detcore) ;;
    *) SHORT="$(git -C "$CO" rev-parse --short HEAD 2>/dev/null)"; emit "$SHA,$SHORT,$(( $(date +%s)-bstart )),$WIDTH,,,,,BUILD_FAIL"; exit 0 ;;
  esac
  ( cd "$CO" && cargo test -p "$DETCOR_PACKAGE" --test "$BIN_NAME" --no-run ) >/dev/null 2>&1 \
    || { SHORT="$(git -C "$CO" rev-parse --short HEAD 2>/dev/null)"; emit "$SHA,$SHORT,$(( $(date +%s)-bstart )),$WIDTH,,,,,BUILD_FAIL"; exit 0; }
  BUILD_S=$(( $(date +%s)-bstart ))
fi
SHORT="$(git -C "$CO" rev-parse --short HEAD 2>/dev/null || echo unknown)"

# Optional evidence capture (attribution). When STRESS_CAPTURE_DIR is set, each
# FAILING burst instance preserves a bundle (stdout/stderr/exit/host-conditions)
# that `attribution.py` can turn from a bare hang-RATE into a CAUSE. Off by
# default => the burst loop below stays byte-for-byte the old >/dev/null idiom.
# Pure bash (capture-run.sh) so the hot loop never forks a per-instance Python.
CAPTURE_DIR="${STRESS_CAPTURE_DIR:-}"
CAPTURE_SH="$(cd "$SELF/.." && pwd)/attribution/capture-run.sh"
if [ -n "$CAPTURE_DIR" ] && [ ! -x "$CAPTURE_SH" ]; then
  echo "stress-burst: STRESS_CAPTURE_DIR set but $CAPTURE_SH missing/x; capture OFF" >&2
  CAPTURE_DIR=""
fi
[ -n "$CAPTURE_DIR" ] && { mkdir -p "$CAPTURE_DIR"; export STRESS_CAPTURE_SHA="$SHORT"; }

# Locate the newest test binary that actually contains TEST_PATH (multiple
# feature builds can coexist in deps/). Mirrors probe.sh's --list verification.
BIN=""
while IFS= read -r cand; do
  [ -x "$cand" ] || continue
  if "$cand" "$TEST_PATH" --exact --list >/dev/null 2>&1 \
     && "$cand" "$TEST_PATH" --exact --list 2>/dev/null | grep -q .; then
    BIN="$cand"; break
  fi
done < <(find "$CO/target" -maxdepth 3 -type f -name "${BIN_NAME}-*" ! -name '*.d' -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-)

[ -n "$BIN" ] || { emit "$SHA,$SHORT,$BUILD_S,$WIDTH,,,,,NOBIN"; exit 0; }
if ! "$BIN" "$TEST_PATH" --exact --list 2>/dev/null | grep -q .; then
  emit "$SHA,$SHORT,$BUILD_S,$WIDTH,,,,,NOTEST"; exit 0
fi

# --- the burst ---------------------------------------------------------------
LOG="$(mktemp -d)"; trap 'rm -rf "$LOG"' EXIT
touch "$LOG/burst.txt"
for i in $(seq 1 "$WIDTH"); do
  if [ -n "$CAPTURE_DIR" ]; then
    # capture-run.sh runs the timeout itself, prints the exit code, and on
    # failure preserves a bundle under CAPTURE_DIR. Label pins the SHA so a
    # multi-SHA capture dir stays attributable.
    ( ec="$("$CAPTURE_SH" "$CAPTURE_DIR" "${SHORT}-inst${i}" "$TIMEOUT" -- \
             "$BIN" "$TEST_PATH" --exact --test-threads=1)"
      echo "$ec" >>"$LOG/burst.txt" ) &
  else
    ( timeout "$TIMEOUT" "$BIN" "$TEST_PATH" --exact --test-threads=1 >/dev/null 2>&1
      echo "$?" >>"$LOG/burst.txt" ) &
  fi
done
wait
# reap any survivors of a hung instance (defensive; timeout should have fired).
pkill -9 -f "$BIN" 2>/dev/null || true

# grep -c already prints 0 on no match (and exits 1, harmless without set -e);
# never append a second 0 or the value becomes multi-line and breaks arithmetic.
HANGS=$(grep -cx 124 "$LOG/burst.txt" 2>/dev/null || true); HANGS=${HANGS:-0}
PASSES=$(grep -cx 0 "$LOG/burst.txt" 2>/dev/null || true); PASSES=${PASSES:-0}
TOTAL=$(wc -l <"$LOG/burst.txt" 2>/dev/null || true); TOTAL=${TOTAL:-0}
OTHER=$((TOTAL - HANGS - PASSES))
RATE=$(awk "BEGIN{ if($TOTAL>0) printf \"%.3f\", $HANGS/$TOTAL; else print \"NA\" }")
emit "$SHA,$SHORT,$BUILD_S,$WIDTH,$HANGS,$PASSES,$OTHER,$RATE,OK"
