#!/usr/bin/env bash
# Stable front door for dev-hermit CI state and operations.
set -euo pipefail
ROOT=$(git -C "$(dirname -- "${BASH_SOURCE[0]}")/.." rev-parse --show-toplevel)
command=${1:-help}
if [[ $# -gt 0 ]]; then shift; fi

if [[ -z ${CI_HUB_TOOL_COST_ACTIVE:-} ]]; then
    basis="not measured: no retained wall/CPU history for ci-hub/$command"
    case "$command" in
        health) basis="not measured: composite repository/API query cost has no retained history" ;;
        main-health) basis="not measured: repository/API query cost has no retained history" ;;
        pr-status|fresh) basis="not measured: planner and GitHub-check query cost has no retained history" ;;
        tick) basis="not measured: due health gates vary and tick cost history is not retained" ;;
        local-history|history) basis="not measured: ledger/store scan cost history is not retained" ;;
        land-lock) basis="not measured: queue wait and optional child command vary; wait/lease values are bounds, not estimates" ;;
        runner-health) basis="not measured: runner/workflow query cost history is not retained" ;;
        arm-land) basis="not measured: verifier launch and GitHub dispatch cost history is not retained" ;;
        obligations|resolve-obligation) basis="not measured: obligation-store operation cost history is not retained" ;;
        watch-obligations)
            basis="not measured: verifier completion time is unknown; polling bounds are not estimates"
            for arg in "$@"; do
                if [[ $arg == --once ]]; then
                    basis="not measured: one exact-SHA obligation poll has no retained cost history"
                fi
            done
            ;;
        refresh-history)
            basis="not measured: incremental history scan cost is not retained"
            for arg in "$@"; do
                if [[ $arg == --full ]]; then
                    basis="not measured: full GitHub Actions backfill size and cost are not known before query"
                fi
            done
            ;;
        help|-h|--help) basis="not measured: static help path has not been timed" ;;
    esac
    exec env CI_HUB_TOOL_COST_ACTIVE=1 "$ROOT/ci-hub/bin/tool-cost" \
        --tool "ci-hub/$command" \
        --estimate-unknown \
        --basis "$basis" -- "$ROOT/ci-hub/ci-hub" "$command" "$@"
fi

case "$command" in
    health)
        rc=0
        "$ROOT/ci-hub/bin/speculative-land" status || rc=$?
        "$ROOT/ci-hub/bin/main-health" "$@" || rc=$?
        pr_rc=0
        "$ROOT/ci-hub/bin/pr-status" "$@" || pr_rc=$?
        [[ $rc -ne 0 ]] || rc=$pr_rc
        exit "$rc"
        ;;
    main-health) exec "$ROOT/ci-hub/bin/main-health" "$@" ;;
    pr-status|fresh) exec "$ROOT/ci-hub/bin/pr-status" "$@" ;;
    tick) exec "$ROOT/ci-hub/bin/health-tick" "$@" ;;
    arm-land) exec "$ROOT/ci-hub/bin/speculative-land" arm "$@" ;;
    obligations) exec "$ROOT/ci-hub/bin/speculative-land" status "$@" ;;
    watch-obligations) exec "$ROOT/ci-hub/bin/speculative-land" watch "$@" ;;
    resolve-obligation) exec "$ROOT/ci-hub/bin/speculative-land" resolve "$@" ;;
    local-history) exec python3 "$ROOT/ci-hub/validate/aggregate.py" "$@" ;;
    land-lock) exec "$ROOT/ci-hub/landing/landing-lock.sh" "$@" ;;
    runner-health) exec python3 "$ROOT/ci-hub/runners/ci-status.py" "$@" ;;
    refresh-history)
        target="$ROOT/ci-hub/history/ingest.py"
        if [[ -x "$target" || -f "$target" ]]; then
            exec python3 "$target" "$@"
        fi
        echo "ci-hub: unified ingester pending; refreshing local validate history" >&2
        exec python3 "$ROOT/ci-hub/validate/aggregate.py" --write-global "$@"
        ;;
    history)
        target="$ROOT/ci-hub/history/query.py"
        if [[ -x "$target" || -f "$target" ]]; then
            exec python3 "$target" "$@"
        fi
        exec python3 "$ROOT/ci-hub/validate/aggregate.py" "$@"
        ;;
    help|-h|--help)
        cat <<'EOF'
usage: ci-hub/ci-hub <command> [args]

  health           summarize current-main and open-PR health from GitHub
  main-health      current-main workflow health only
  pr-status|fresh  pull fresh open-PR CI status via agent-utils
  tick             run the version-pinned tick-hub operational poll
  arm-land         arm local + GitHub verification for a speculative land
  obligations      show unresolved speculative-land obligations
  watch-obligations poll and update unresolved obligations
  resolve-obligation record a completed fix-forward or revert
  refresh-history  incrementally ingest GitHub/local CI history
  history          query the local commit/CI history store
  local-history    query legacy/local validate-run records
  runner-health    summarize self-hosted runners and recent workflows
  land-lock        shared-file LANDING MUTEX (acquire|renew|release|status|run)
                   every lander MUST hold it around re-union->push->stamp->merge
EOF
        ;;
    *) echo "ci-hub: unknown command: $command (run ci-hub/ci-hub help)" >&2; exit 2 ;;
esac
