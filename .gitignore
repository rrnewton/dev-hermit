/ai_docs/**/*.o
/ai_docs/**/*.pdf
/ai_docs/**/*.png
/ai_docs/**/*.so
/ai_docs/**/*.tar
/ai_docs/**/*.tgz
/ai_docs/**/*.webp
/ai_docs/**/*.zip
ignored/
ACTIVE.md

