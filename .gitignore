/.api_keys.env
/.gh.env
/.oauth.env
/.ops-driver.env
/.ops-state.json
/.ops-state.yaml

# Physical worktrees and disposable work areas are machine-local.
/worktree/
/worktrees/*
!/worktrees/ARCHIVED.md
/main/
/scratch/
/targets/
/target/
/ignored/

