# Vendored upstream checkouts do not belong in the parent history. Experiments
# must record source URLs + commit SHAs for reproducibility, not embed a full
# clone (a nested .git would otherwise be at risk of accidental staging).
/experiments/gvisor/

# Per-experiment scratch space (experiments/ignored/ is also covered by the
# global `ignored/` rule below; listed explicitly for discoverability).
/experiments/ignored/
**/ignored/

# Protective guards against accidentally committing large/binary experiment
# artifacts. Durable evidence stays as text (README/CSV/JSON/TSV); heavy
# outputs live under an ignored/ scratch dir or an external artifact store.
/experiments/**/*.img
/experiments/**/*.qcow2
/experiments/**/*.raw
/experiments/**/*.iso
/experiments/**/*.bin
/experiments/**/*.a
/experiments/**/*.o
/experiments/**/*.so
/experiments/**/*.tar
/experiments/**/*.tar.*
/experiments/**/*.tgz
/experiments/**/*.gz
/experiments/**/*.zip
/experiments/**/*.zst
/experiments/**/*.core
/experiments/**/core.[0-9]*
/experiments/**/bzImage
/experiments/**/vmlinux
/experiments/**/initramfs*.cpio*
/experiments/**/*.cpio
/experiments/**/boots-*/
/experiments/**/boot-*/

# debug/ debugging-episode infra (#40): each episode dir holds machine-readable
# state (episode/hypotheses/evidence/suspects JSON) + reports/NOTEBOOK only.
# DEFAULT: write anything you know you won't commit -- raw logs, boot artifacts,
# scratch, big outputs -- DIRECTLY into <episode>/ignored/ from the start (it is
# gitignored below), so there is no commit-time judgment call. Episodes REFERENCE
# such artifacts by path. Small CURATED logs MAY be tracked (.log is intentionally
# NOT blanket-ignored); the pre-commit size hook (.githooks/pre-commit) is the
# backstop for oversized staged files, and each episode may add its own
# <episode>/.gitignore to tune what lives-but-ignored locally.
# Hard-ignored here = clearly-never-commit artifacts only.
/debug/**/boots-*/
/debug/**/boot-*/
/debug/**/runs/
/debug/**/ignored/
/debug/**/*.img
/debug/**/*.qcow2
/debug/**/*.raw
/debug/**/*.iso
/debug/**/*.bin
/debug/**/*.a
/debug/**/*.o
/debug/**/*.so
/debug/**/*.tar
/debug/**/*.tar.*
/debug/**/*.tgz
/debug/**/*.gz
/debug/**/*.zip
/debug/**/*.zst
/debug/**/*.core
/debug/**/core.[0-9]*
/debug/**/bzImage
/debug/**/vmlinux
/debug/**/initramfs*.cpio*
/debug/**/*.cpio

# Transient tooling output. NOTE: *.log is intentionally NOT blanket-ignored --
# a blanket rule is too blunt (small curated logs are wanted, and blanket-ignore
# forces agents to force-add the ones they want, which they won't). Oversized
# staged files (logs or otherwise) are caught by the pre-commit size hook
# (.githooks/pre-commit, install via scripts/setup-hooks.sh). Raw giant logs
# belong under an ignored/ dir. Clearly-never-commit artifacts stay hard-ignored
# above (images, kernels/initrd, boots-*/, archives, binaries, core dumps).
**/__pycache__/
*.perf.data

# High-volume per-run transcripts stay local.  Compact, durable tables are
# promoted to each experiment's results directory before publication.
/experiments/btrfs_userspace_fuzz_cases_20260728/runs/
/experiments/btrfs_userspace_logic_20260728/runs/

