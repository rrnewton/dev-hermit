#!/usr/bin/env python3
"""Filing-time / pre-dispatch guard: does a task state a checkable success condition?

DELIBERATELY TWO-TIER, and the second tier is deliberately weak:

  NO-VERIFY      structural, zero judgement, 100% reliable -- the description carries
                 no Verify/Success-criteria/Done-when clause at all.
  VACUOUS-STOCK  a curated denylist of stock phrases measured to recur in this graph
                 ("Pass/fail", "Results documented", ...). HIGH PRECISION, LOW RECALL
                 on purpose.

It does NOT try to judge checkability in general. That was measured: a regex looking for
commands/paths/numbers/SHAs had a 60% FALSE-NEGATIVE rate against hand adjudication
(n=30), i.e. it would reject ~3 of every 5 perfectly good Verify lines. A guard that
noisy gets disabled within a day. Bind the gate to the fact you can observe (the clause
exists / it is a known stock phrase), not to the fact you wish you could observe
(the clause is meaningful).
"""
import argparse, json, re, sqlite3, sys

MARK = re.compile(r'(?im)^\s*(?:\*{0,2}|#{1,4}\s*)?'
                  r'(verify|verification|success criteria|acceptance criteria|done when|'
                  r'definition of done)\b\s*[:\-]')
INLINE = re.compile(r'(?i)\bverify\s*:')
STOCK = [r'pass\s*/\s*fail\.?$', r'results?\s+documented\.?$', r'report\s+pushed\.?$',
         r'pr\s+count\.?$', r'findings?\s+posted\.?$', r'results?\s+posted\.?$',
         r'documented\.?$', r'done\.?$', r'works\.?$', r'no\s+regressions?\.?$']
STOCK_RE = re.compile(r'(?i)^\W*(?:verify|verification)\W*(?:%s)' % '|'.join(STOCK))

def clause(desc):
    d = desc or ''
    m = MARK.search(d) or INLINE.search(d)
    return None if not m else re.split(r'\n\s*\n', d[m.start():])[0].strip()

def classify(desc):
    c = clause(desc)
    if c is None:
        return 'NO-VERIFY', None
    if STOCK_RE.match(c):
        return 'VACUOUS-STOCK', c
    return 'OK', c

def naive_classify(desc):
    """The guard someone would write first: just grep for the label."""
    return 'OK' if INLINE.search(desc or '') or MARK.search(desc or '') else 'NO-VERIFY'

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--db', default='/home/newton/.tg/hermit.db')
    ap.add_argument('--status', action='append', default=None,
                    help='restrict to these statuses (repeatable); default: all')
    ap.add_argument('--task', help='lint one task by local_id; exit 1 if it fails')
    ap.add_argument('--description', help='lint a literal description instead of the DB')
    ap.add_argument('--json', action='store_true')
    a = ap.parse_args()

    if a.description is not None:
        verdict, c = classify(a.description)
        print(f"{verdict}\tnaive-guard-says={naive_classify(a.description)}\t{c!r}")
        return 0 if verdict == 'OK' else 1

    db = sqlite3.connect(a.db)
    q = "SELECT local_id,status,description FROM tasks"
    args = []
    if a.task:
        q += " WHERE local_id=?"; args = [a.task]
    elif a.status:
        q += " WHERE status IN (%s)" % ','.join('?' * len(a.status)); args = a.status
    rows = db.execute(q, args).fetchall()
    counts, offenders = {'OK': 0, 'NO-VERIFY': 0, 'VACUOUS-STOCK': 0}, []
    for lid, st, desc in rows:
        v, c = classify(desc)
        counts[v] += 1
        if v != 'OK':
            offenders.append({'local_id': lid, 'status': st, 'verdict': v, 'clause': c})
    if a.json:
        print(json.dumps({'checked': len(rows), 'counts': counts, 'offenders': offenders}, indent=1))
    else:
        n = len(rows) or 1
        for k in ('OK', 'NO-VERIFY', 'VACUOUS-STOCK'):
            print(f"  {k:14s} {counts[k]:5d}/{len(rows)}  {100*counts[k]/n:5.1f}%")
    return 0 if counts['NO-VERIFY'] == 0 and counts['VACUOUS-STOCK'] == 0 else 1

if __name__ == '__main__':
    sys.exit(main())
