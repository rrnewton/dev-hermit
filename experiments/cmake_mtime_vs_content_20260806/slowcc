#!/bin/bash
# stand-in for cc1plus on a heavy TU: starts writing its -o target, then takes a long time
out=""; i=0; argv=("$@")
while [ $i -lt ${#argv[@]} ]; do [ "${argv[$i]}" = "-o" ] && out="${argv[$((i+1))]}"; i=$((i+1)); done
: > "$out"        # output file created empty, as a real compiler does
sleep 30          # long enough for the OOM killer to land
printf '\177ELF fake payload' > "$out"
