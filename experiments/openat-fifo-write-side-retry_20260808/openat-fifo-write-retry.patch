+// AUTONOMOUS-BOT-IMPLEMENTED
+// TODO-HUMAN-REVIEW(#1850): Write-opening a FIFO with no reader blocks in the
+// kernel at `wait_for_partner`. Under `--sequentialize-threads` the opener holds
+// the scheduler turn while blocked, and the only task that can unblock it -- the
+// peer opening the read end -- is queued behind that turn, so the guest
+// deadlocks. This is instance 3 of the blocking-while-holding-the-turn defect
+// class; instance 1 was `epoll_pwait` (#1864).
+//
+// The write side converts cleanly and does NOT need `BlockedPool` modelling.
+// `O_WRONLY|O_NONBLOCK` on a readerless FIFO returns ENXIO, which is a precise
+// "no reader has arrived yet" -- so a yield-and-retry loop resumes at exactly
+// the moment a blocking open would have returned, with no timing information
+// invented. Measured on this host (`harness/fifo-open-semantics.c`):
+//
+//     O_WRONLY|O_NONBLOCK, no reader   -> ENXIO
+//     O_WRONLY|O_NONBLOCK, reader present -> succeeds
+//     O_WRONLY, no reader              -> blocks (the bug)
+//
+// The READ side is deliberately NOT handled here: its `O_NONBLOCK` open succeeds
+// and the first `read()` then reports a spurious EOF, so a guest that should
+// have waited would instead see end-of-input. Linux exposes no non-consuming
+// "does this FIFO have a writer?" probe, so the read side genuinely requires
+// scheduler-level modelling. Converting it with this mechanism would silently
+// corrupt guest input, which is worse than the hang.
+//
+// ENXIO rather than EAGAIN is why the generic machinery did not already cover
+// this: `syscall_would_have_blocked` defaults to a different predicate, so the
+// override below is the whole of the second obstacle.
+#[async_trait]
+impl NonblockableSyscall for reverie::syscalls::Openat {
+    async fn into_nonblocking<T: RecordOrReplay, G: Guest<Detcore<T>>>(
+        self,
+        _guest: &mut G,
+    ) -> (Self, Option<<G::Stack as Stack>::StackGuard>) {
+        (self.with_flags(self.flags() | OFlag::O_NONBLOCK), None)
+    }
+
+    fn syscall_would_have_blocked(&self, res: Result<i64, Errno>) -> bool {
+        res == Err(Errno::ENXIO)
+    }
+
+    fn signal_interrupt_errno(&self) -> Errno {
+        Errno::EINTR
+    }
+}
+
+// `retry_nonblocking_syscall_with_timeout` requires this bound even when the
+// caller passes `None`. `openat(2)` has no timeout in the kernel API and Detcore
+// never supplies one for it, so this arm is unreachable; return a distinctive
+// errno rather than a plausible success so that if it ever DOES fire, it
+// surfaces as an obvious bug instead of a silently-invented open failure.
+impl TimeoutableSyscall for reverie::syscalls::Openat {
+    fn timeout_return_val(&self) -> Result<i64, Errno> {
+        Err(Errno::ETIMEDOUT)
+    }
+}
