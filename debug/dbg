STARTER_GITIGNORE = """\
# Per-episode hygiene (tune locally). DEFAULT: write anything you won't commit --
# raw logs, boot artifacts, scratch, big outputs -- DIRECTLY under ignored/ from
# the start; it is gitignored, so no commit-time judgment is needed. Only reports,
# NOTEBOOK.md, and machine-readable state (episode/hypotheses/evidence/suspects
# JSON) live tracked here. The repo pre-commit size hook is only a backstop.
# NOTE: *.log is intentionally NOT ignored -- small curated logs may be tracked;
# put big/raw logs under ignored/. Add/remove patterns below to fit this episode.
ignored/
boots-*/
boot-*/
runs/
*.qcow2
*.img
*.raw
*.iso
*.cpio
*.cpio.gz
bzImage
vmlinux
*.core
*.perf.data
"""


def _starter_vcs_missing(slug: str) -> str:
    return f"""\
# VCS_MISSING — {slug}

What is **not** checked in for this episode (won't exist on a fresh clone). Keep
this current: whenever you leave an artifact untracked (e.g. write it under
`ignored/`), add a row. Run `dbg vcs-check {slug}` to list currently-ignored paths.

| path (rel to this dir) | what it is | regeneratable? | how to regenerate | tracked code READS it? |
|---|---|---|---|---|
| ignored/ | raw scratch: logs, boot artifacts, big outputs | yes | see Notes | no |

## Notes
- DEFAULT: un-committable artifacts are written under `ignored/` from the start.
- Regeneration: <commands / scripts that reproduce the missing artifacts>.
- Runtime dependency: if ANY tracked script/tool READS a missing path it WILL fail
  on another machine -- list it above and mark the last column "yes". None known
  so far (confirm as the episode grows).
"""


def cmd_new_episode(a):
    d = ROOT / a.slug
    if (d / "episode.json").exists():
        sys.exit(f"episode {a.slug} already exists")
    d.mkdir(parents=True, exist_ok=True)
    save(a.slug, "episode", {"slug": a.slug, "title": a.title or a.slug,
                             "status": "open", "question": a.question or "",
                             "owner": a.owner or ""})
    for n in ("hypotheses", "suspects", "evidence"):
        save(a.slug, n, [])
    # Hygiene scaffolding: per-episode .gitignore, VCS_MISSING.md, and an ignored/
    # scratch dir so raw artifacts have a gitignored home from the very start.
    (d / ".gitignore").write_text(STARTER_GITIGNORE)
    (d / "VCS_MISSING.md").write_text(_starter_vcs_missing(a.slug))
    (d / "ignored").mkdir(exist_ok=True)
    (d / "ignored" / ".keep").write_text("")  # local anchor (ignored/ is gitignored)
    print(f"created episode {a.slug} at {d}")
    print("  scaffolded: episode/hypotheses/evidence/suspects.json, .gitignore, "
          "VCS_MISSING.md, ignored/")
    print("  next: write NOTEBOOK.md (EXPLORED/INVALIDATED/FRONTIER), then "
          f"`dbg notebook-sync {a.slug}`")


def _next_id(items, prefix):
    n = len(items) + 1
    return f"{prefix}{n:02d}"


def cmd_add_hypothesis(a):
    hs = load(a.episode, "hypotheses")
    hs.append({"id": a.id, "statement": a.statement, "reasoning": a.reasoning or "",
               "predicted_evidence": a.predicted or "", "status": "open",
               "verdict": "", "evidence_ids": [], "owner": a.owner or ""})
    save(a.episode, "hypotheses", hs)
    print(f"added {a.id}")


def cmd_set_hypothesis(a):
    hs = load(a.episode, "hypotheses")
    for h in hs:
        if h["id"] == a.id:
            if a.status:
                if a.status not in HYP_STATUSES:
                    sys.exit(f"status must be one of {HYP_STATUSES}")
                h["status"] = a.status
            if a.verdict:
                h["verdict"] = a.verdict
            save(a.episode, "hypotheses", hs)
            print(f"{a.id} -> status={h['status']}")
            return
    sys.exit(f"no hypothesis {a.id}")


def cmd_add_suspect(a):
    ss = load(a.episode, "suspects")
    ss.append({"id": _next_id(ss, "S"), "sha": a.sha, "subject": a.subject,
               "subsystem": a.subsystem or "", "date": a.date or "",
               "files": a.files.split(",") if a.files else [],
               "interval": a.interval or "", "priority": a.priority or "medium",
               "status": "open", "reasoning": a.reasoning or ""})
    save(a.episode, "suspects", ss)
    print(f"added suspect {ss[-1]['id']} {a.sha[:12]}")


def cmd_set_suspect(a):
    ss = load(a.episode, "suspects")
    for s in ss:
        if s.get("id") == a.id or s.get("sha", "").startswith(a.id):
            if a.status:
                if a.status not in SUS_STATUSES:
                    sys.exit(f"status must be one of {SUS_STATUSES}")
                s["status"] = a.status
            if a.reasoning:
                s["reasoning"] = (s.get("reasoning", "") + " | " + a.reasoning).strip(" |")
            save(a.episode, "suspects", ss)
            print(f"{s['id']} {s['sha'][:12]} -> status={s['status']}")
            return
    sys.exit(f"no suspect {a.id}")


def cmd_add_evidence(a):
    ev = load(a.episode, "evidence")
    ev.append({"id": a.id or _next_id(ev, "E"), "desc": a.desc,
               "hypotheses": a.hypotheses.split(",") if a.hypotheses else [],
               "artifact": a.artifact or "", "source": a.source or ""})
    save(a.episode, "evidence", ev)
    print(f"added evidence {ev[-1]['id']}")


# --------------------------------------------------------------------------- #
# lab notebook (agent-synthesized curated prose) + what-changed delta         #
# --------------------------------------------------------------------------- #
# The notebook (NOTEBOOK.md) is NOT generated by this CLI -- it is curated prose
# an agent writes and revises for global consistency (EXPLORED / INVALIDATED /
# FRONTIER). The CLI's job is to make the synthesize-and-revise pass easy by
# surfacing exactly WHAT CHANGED in the machine-readable state since the notebook
# was last synced, so the agent knows what to fold in and re-check globally.

NOTEBOOK = "NOTEBOOK.md"
NB_STATE = ".notebook-state.json"  # snapshot of state at last notebook sync


def _rec_hash(rec: dict) -> str:
    return hashlib.sha256(json.dumps(rec, sort_keys=True).encode()).hexdigest()[:12]


def _current_state(slug: str) -> dict:
    """{record_type: {id: {status, hash}}} + episode hash — the syncable state."""
    out = {}
    for name, idf in (("hypotheses", "id"), ("evidence", "id"), ("suspects", "id")):
        recs = load(slug, name)
        out[name] = {r.get(idf, f"?{i}"): {"status": r.get("status", ""), "hash": _rec_hash(r)}
                     for i, r in enumerate(recs)}
    out["episode"] = {"hash": _rec_hash(load(slug, "episode"))}
    return out


def _diff_state(old: dict, new: dict) -> dict:
    """Per record-type: added / removed / status_changed / content_changed id lists."""
    report = {}
    for name in ("hypotheses", "evidence", "suspects"):
        o, n = old.get(name, {}), new.get(name, {})
        added = sorted(set(n) - set(o))
        removed = sorted(set(o) - set(n))
        status_ch, content_ch = [], []
        for k in sorted(set(o) & set(n)):
            if o[k].get("status") != n[k].get("status"):
                status_ch.append(f"{k} ({o[k].get('status')}->{n[k].get('status')})")
            elif o[k].get("hash") != n[k].get("hash"):
                content_ch.append(k)
        report[name] = {"added": added, "removed": removed,
                        "status_changed": status_ch, "content_changed": content_ch}
    report["episode_changed"] = old.get("episode", {}).get("hash") != new.get("episode", {}).get("hash")
    return report


def _load_synced(slug: str) -> dict:
    p = episode_dir(slug) / NB_STATE
    return json.loads(p.read_text()).get("state", {}) if p.exists() else {}


def cmd_changed(a):
    """What changed in the machine-readable state since the notebook was last synced."""
    new = _current_state(a.episode)
    old = _load_synced(a.episode)
    nb = episode_dir(a.episode) / NOTEBOOK
    rep = _diff_state(old, new)
    any_change = (not old) or rep["episode_changed"] or any(
        rep[n][k] for n in ("hypotheses", "evidence", "suspects")
        for k in ("added", "removed", "status_changed", "content_changed"))
    if a.json:
        print(json.dumps({"notebook_exists": nb.exists(), "ever_synced": bool(old),
                          "dirty": any_change, "changes": rep}, indent=2))
        sys.exit(1 if any_change else 0)
    if not nb.exists():
        print(f"NOTEBOOK.md MISSING for {a.episode} — write it (EXPLORED / INVALIDATED / "
              f"FRONTIER) then `dbg notebook-sync {a.episode}`.")
    if not old:
        print("notebook never synced: run `dbg notebook-sync` after writing NOTEBOOK.md.")
    if not any_change and old:
        print(f"notebook IN SYNC with machine-readable state ({nb}). Nothing to fold in.")
        return
    print("CHANGED since last notebook sync — SYNTHESIZE these into NOTEBOOK.md, then re-read the")
    print("whole notebook for GLOBAL CONSISTENCY (EXPLORED / INVALIDATED / FRONTIER), then sync:\n")
    label = {"added": "NEW", "removed": "REMOVED", "status_changed": "STATUS", "content_changed": "EDITED"}
    for name in ("hypotheses", "suspects", "evidence"):
        for k in ("added", "status_changed", "removed", "content_changed"):
            vals = rep[name][k]
            if vals:
                print(f"  {name:10} {label[k]:8}: {', '.join(vals)}")
    if rep["episode_changed"]:
        print("  episode    EDITED  : episode.json (title/status/anchors/summary)")
    print("\nThen: dbg notebook-sync " + a.episode)
    sys.exit(1)


def cmd_notebook_sync(a):
    """Snapshot current state as the notebook's baseline (call AFTER revising NOTEBOOK.md)."""
    nb = episode_dir(a.episode) / NOTEBOOK
    if not nb.exists() and not a.force:
        sys.exit(f"NOTEBOOK.md missing for {a.episode}; write it first (or --force to snapshot anyway).")
    state = _current_state(a.episode)
    (ROOT / a.episode / NB_STATE).write_text(json.dumps(
        {"note": "state snapshot at last NOTEBOOK.md synthesis; `dbg changed` diffs against this",
         "state": state}, indent=2) + "\n")
    n = sum(len(state[x]) for x in ("hypotheses", "evidence", "suspects"))
    print(f"notebook synced: snapshot of {n} records written to {a.episode}/{NB_STATE}")


def cmd_notebook(a):
    nb = episode_dir(a.episode) / NOTEBOOK
    if not nb.exists():
        sys.exit(f"no NOTEBOOK.md for {a.episode}")
    sys.stdout.write(nb.read_text())


def cmd_vcs_check(a):
    """List files under the episode dir that git IGNORES (won't exist on a fresh
    clone) so VCS_MISSING.md can be kept current."""
    d = episode_dir(a.episode)
    files = [str(p) for p in sorted(d.rglob("*")) if p.is_file()]
    ignored = []
    if files:
        # git check-ignore --stdin prints the paths that ARE ignored.
        try:
            r = subprocess.run(["git", "check-ignore", "--stdin"],
                               input="\n".join(files), capture_output=True, text=True)
            ignored = sorted(x for x in r.stdout.splitlines() if x.strip())
        except Exception as e:  # noqa: BLE001
            sys.exit(f"git check-ignore failed: {e}")
    vcs = d / "VCS_MISSING.md"
    if a.json:
        print(json.dumps({"episode": a.episode, "vcs_missing_exists": vcs.exists(),
                          "ignored_paths": [str(Path(x).relative_to(d)) for x in ignored]},
                         indent=2))
        return
    if not vcs.exists():
        print(f"VCS_MISSING.md MISSING for {a.episode} — scaffold one (see policy) and "
              f"list what's below.")
    print(f"Files under {a.episode}/ that git IGNORES (NOT on a fresh clone -> "
          f"must be in VCS_MISSING.md):")
    if not ignored:
        print("  (none — every file here is tracked)")
    else:
        # collapse to top-level dirs + loose files for readability
        tops = sorted({str(Path(x).relative_to(d)).split("/")[0] for x in ignored})
        for t in tops:
            n = sum(1 for x in ignored if str(Path(x).relative_to(d)).split("/")[0] == t)
            print(f"  {t}{'/' if (d / t).is_dir() else ''}  ({n} file(s))")
    print("\nKeep VCS_MISSING.md current: for each, note regeneratable? how? does "
          "tracked code READ it?")


