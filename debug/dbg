#!/usr/bin/env python3
"""dbg — a tiny CLI over persistent debugging *episodes*.

A debugging episode is a subdirectory of debug/ (e.g. debug/demo5-regression/)
holding three machine-readable JSON files that make an "automated-scientist"
investigation reusable and queryable:

  episode.json     metadata: title, status, the GOOD/BAD anchors, the question
  hypotheses.json  each hypothesis: statement, detailed reasoning, predicted
                   evidence, status (open|confirmed|killed) + verdict reasoning
  evidence.json    evidence items bound to hypotheses (artifact paths, source)
  suspects.json    candidate regressing commits/causes: sha, subsystem, files,
                   status (open|cleared|confirmed) + reasoning

The point: any regression investigation gets the same structure, and the state
of the search (which hypotheses survive, which suspects remain open) is a query,
not prose someone has to re-read.

Usage:
  ./debug/dbg episodes
  ./debug/dbg hypotheses <episode> [--status open|closed|all] [-v]
  ./debug/dbg suspects   <episode> [--status open|cleared|confirmed|all] [--open] [-v]
  ./debug/dbg evidence   <episode> [--hypothesis Hn]
  ./debug/dbg history    <episode> [--kind KIND] [--hypothesis Hn] [--suspect Sn] [-v]
  ./debug/dbg show       <episode> <id>
  ./debug/dbg summary    <episode>

  # mutations (write back to the JSON):
  ./debug/dbg new-episode <slug> --title "..."
  ./debug/dbg add-hypothesis   <episode> --id Hn --statement "..." [--reasoning "..."]
  ./debug/dbg set-hypothesis   <episode> <Hn> --status confirmed|killed|open [--verdict "..."]
  ./debug/dbg add-suspect      <episode> --sha SHA --subject "..." [--subsystem ..] [--files a,b]
  ./debug/dbg set-suspect      <episode> <id|sha> --status open|cleared|confirmed [--reasoning "..."]
  ./debug/dbg add-evidence     <episode> --id En --desc "..." [--hypotheses H1,H2] [--artifact PATH]

Machine-readable: every list/show also accepts --json for raw JSON output, so
the CLI composes with jq and other tooling.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent  # the debug/ dir

HYP_STATUSES = ("open", "confirmed", "killed")
SUS_STATUSES = ("open", "cleared", "confirmed")
CLOSED_HYP = ("confirmed", "killed")  # terminal hypothesis states


# --------------------------------------------------------------------------- #
# storage helpers                                                             #
# --------------------------------------------------------------------------- #
def episode_dir(slug: str) -> Path:
    d = ROOT / slug
    if not (d / "episode.json").exists():
        sys.exit(f"no episode {slug!r} (expected {d}/episode.json). "
                 f"run `dbg episodes` to list.")
    return d


def load(slug: str, name: str) -> list | dict:
    p = episode_dir(slug) / f"{name}.json"
    if not p.exists():
        return [] if name != "episode" else {}
    return json.loads(p.read_text())


def save(slug: str, name: str, data) -> None:
    p = ROOT / slug / f"{name}.json"
    p.write_text(json.dumps(data, indent=2) + "\n")


def all_episodes() -> list[Path]:
    return sorted(d for d in ROOT.iterdir()
                  if d.is_dir() and (d / "episode.json").exists())


# --------------------------------------------------------------------------- #
# formatting                                                                  #
# --------------------------------------------------------------------------- #
HMARK = {"open": "[ OPEN ]", "confirmed": "[CONFIRMED]", "killed": "[ KILLED ]"}
SMARK = {"open": "[ OPEN ]", "cleared": "[CLEARED]", "confirmed": "[CONFIRMED]"}


def wrap(text: str, indent: str) -> str:
    import textwrap
    out = []
    for para in (text or "").split("\n"):
        out.append(textwrap.fill(para, width=94,
                                 initial_indent=indent, subsequent_indent=indent)
                   if para.strip() else "")
    return "\n".join(out)


# --------------------------------------------------------------------------- #
# commands                                                                    #
# --------------------------------------------------------------------------- #
def cmd_episodes(a):
    eps = all_episodes()
    if a.json:
        print(json.dumps([json.loads((d / "episode.json").read_text()) for d in eps], indent=2))
        return
    if not eps:
        print("(no episodes yet — create one with `dbg new-episode <slug>`)")
        return
    for d in eps:
        e = json.loads((d / "episode.json").read_text())
        hs = json.loads((d / "hypotheses.json").read_text()) if (d / "hypotheses.json").exists() else []
        ss = json.loads((d / "suspects.json").read_text()) if (d / "suspects.json").exists() else []
        open_h = sum(1 for h in hs if h.get("status") == "open")
        open_s = sum(1 for s in ss if s.get("status") == "open")
        print(f"{e.get('slug', d.name):22} [{e.get('status','?'):>6}]  "
              f"{len(hs)} hypotheses ({open_h} open)  {len(ss)} suspects ({open_s} open)")
        print(f"{'':22}  {e.get('title','')}")


def cmd_hypotheses(a):
    hs = load(a.episode, "hypotheses")
    status = a.status or ("closed" if a.closed else "all")
    if status == "closed":
        hs = [h for h in hs if h.get("status") in CLOSED_HYP]
    elif status in HYP_STATUSES:
        hs = [h for h in hs if h.get("status") == status]
    if a.json:
        print(json.dumps(hs, indent=2))
        return
    if not hs:
        print(f"(no hypotheses matching status={status})")
        return
    for h in hs:
        print(f"\n{HMARK.get(h.get('status'), '[?]')} {h['id']}: {h.get('statement','')}")
        if h.get("owner"):
            print(f"    owner: {h['owner']}")
        if a.verbose:
            if h.get("reasoning"):
                print("  reasoning:")
                print(wrap(h["reasoning"], "    "))
            if h.get("predicted_evidence"):
                print("  predicted evidence:")
                print(wrap(h["predicted_evidence"], "    "))
        if h.get("verdict"):
            print("  verdict:")
            print(wrap(h["verdict"], "    "))
        if h.get("evidence_ids"):
            print(f"    evidence: {', '.join(h['evidence_ids'])}")


def cmd_suspects(a):
    ss = load(a.episode, "suspects")
    status = "open" if a.open else (a.status or "all")
    if status in SUS_STATUSES:
        ss = [s for s in ss if s.get("status") == status]
    # stable, useful ordering: open first, then by priority then date
    prio = {"high": 0, "medium": 1, "low": 2}
    ss = sorted(ss, key=lambda s: (s.get("status") != "open",
                                   prio.get(s.get("priority", "medium"), 1),
                                   s.get("date", "")))
    if a.json:
        print(json.dumps(ss, indent=2))
        return
    if not ss:
        print(f"(no suspects matching status={status})")
        return
    print(f"{len(ss)} suspect(s) [status filter: {status}]")
    for s in ss:
        pr = s.get("priority", "?")
        print(f"\n{SMARK.get(s.get('status'), '[?]')} {s.get('id','?')} {s.get('sha','')[:12]}"
              f"  ({pr:>6} priority, {s.get('subsystem','?')})  {s.get('date','')[:10]}")
        print(f"    {s.get('subject','')}")
        if a.verbose or status != "all":
            if s.get("files"):
                print(f"    files: {', '.join(s['files'])}")
            if s.get("reasoning"):
                print(wrap(s["reasoning"], "    "))


def cmd_evidence(a):
    ev = load(a.episode, "evidence")
    if a.hypothesis:
        ev = [e for e in ev if a.hypothesis in e.get("hypotheses", [])]
    if a.json:
        print(json.dumps(ev, indent=2))
        return
    for e in ev:
        print(f"\n{e.get('id','?')}  (H: {', '.join(e.get('hypotheses', [])) or '-'})")
        print(wrap(e.get("desc", ""), "    "))
        if e.get("artifact"):
            print(f"    artifact: {e['artifact']}")
        if e.get("source"):
            print(f"    source: {e['source']}")


def _load_history(slug: str) -> list[dict]:
    """Read and structurally validate the episode's append-only JSONL journal."""
    p = episode_dir(slug) / "history" / "events.jsonl"
    if not p.exists():
        return []

    events = []
    seen_ids = set()
    previous_seq = 0
    for line_number, raw in enumerate(p.read_text().splitlines(), 1):
        if not raw.strip():
            sys.exit(f"{p}:{line_number}: blank lines are not valid history events")
        try:
            event = json.loads(raw)
        except json.JSONDecodeError as exc:
            sys.exit(f"{p}:{line_number}: invalid JSON: {exc.msg}")
        if not isinstance(event, dict):
            sys.exit(f"{p}:{line_number}: history event must be a JSON object")

        seq = event.get("seq")
        event_id = event.get("event_id")
        if not isinstance(seq, int) or seq <= previous_seq:
            sys.exit(f"{p}:{line_number}: seq must be an integer greater than "
                     f"{previous_seq}, got {seq!r}")
        if not isinstance(event_id, str) or not event_id:
            sys.exit(f"{p}:{line_number}: event_id must be a non-empty string")
        if event_id in seen_ids:
            sys.exit(f"{p}:{line_number}: duplicate event_id {event_id!r}")
        previous_seq = seq
        seen_ids.add(event_id)
        events.append(event)
    return events


def _history_ref_matches(refs, wanted: str) -> bool:
    for ref in refs or []:
        if isinstance(ref, dict):
            if wanted in (ref.get("id"), ref.get("slug")):
                return True
        elif wanted == ref:
            return True
    return False


def cmd_history(a):
    events = _load_history(a.episode)
    if a.kind:
        events = [e for e in events if e.get("kind") in a.kind]
    if a.hypothesis:
        events = [e for e in events
                  if _history_ref_matches(e.get("hypothesis_refs"), a.hypothesis)]
    if a.suspect:
        events = [e for e in events
                  if _history_ref_matches(e.get("suspect_refs"), a.suspect)]
    if a.since_seq is not None:
        events = [e for e in events if e.get("seq", 0) >= a.since_seq]
    if a.until_seq is not None:
        events = [e for e in events if e.get("seq", 0) <= a.until_seq]

    if a.json:
        print(json.dumps(events, indent=2))
        return
    if not events:
        print("(no history events matching the query)")
        return

    print(f"{len(events)} history event(s)")
    for event in events:
        print(f"\n{event['seq']:04d} {event['event_id']}  "
              f"[{event.get('kind', '?')}]  {event.get('observed_at', '?')}")
        print(wrap(event.get("summary", ""), "    "))
        hrefs = [r.get("id") or r.get("slug") for r in event.get("hypothesis_refs", [])
                 if isinstance(r, dict)]
        srefs = [r.get("id") or r.get("slug") if isinstance(r, dict) else r
                 for r in event.get("suspect_refs", [])]
        refs = [*filter(None, hrefs), *filter(None, srefs)]
        if refs:
            print(f"    refs: {', '.join(refs)}")
        if a.verbose:
            source = event.get("source")
            if source:
                print(f"    source: {json.dumps(source, sort_keys=True)}")
            details = event.get("details")
            if details:
                print(f"    details: {json.dumps(details, sort_keys=True)}")
            for artifact in event.get("artifacts", []):
                print(f"    artifact: {artifact}")
            if event.get("supersedes"):
                print(f"    supersedes: {', '.join(event['supersedes'])}")


def cmd_show(a):
    for name in ("hypotheses", "suspects", "evidence"):
        for item in load(a.episode, name):
            if item.get("id") == a.id or item.get("sha", "").startswith(a.id):
                print(json.dumps(item, indent=2))
                return
    sys.exit(f"no item {a.id!r} in episode {a.episode}")


def cmd_summary(a):
    e = load(a.episode, "episode")
    hs = load(a.episode, "hypotheses")
    ss = load(a.episode, "suspects")
    if a.json:
        print(json.dumps({"episode": e,
                          "hypotheses_open": [h["id"] for h in hs if h.get("status") == "open"],
                          "hypotheses_confirmed": [h["id"] for h in hs if h.get("status") == "confirmed"],
                          "hypotheses_killed": [h["id"] for h in hs if h.get("status") == "killed"],
                          "suspects_open": [s.get("id") for s in ss if s.get("status") == "open"]},
                         indent=2))
        return
    print(f"# {e.get('title','')}  [{e.get('status','?')}]")
    print(f"slug: {e.get('slug')}   owner: {e.get('owner','')}")
    if e.get("anchors"):
        g = e["anchors"].get("good", {}); b = e["anchors"].get("bad", {})
        print(f"GOOD: {g.get('sha','?')[:12]} {g.get('note','')}")
        print(f"BAD : {b.get('sha','?')[:12]} {b.get('note','')}")
    print(wrap(e.get("question", ""), "  "))
    conf = [h['id'] for h in hs if h.get('status') == 'confirmed']
    kill = [h['id'] for h in hs if h.get('status') == 'killed']
    opn = [h['id'] for h in hs if h.get('status') == 'open']
    print(f"\nhypotheses: {len(hs)}  confirmed={conf} killed={kill} open={opn}")
    os_ = [s for s in ss if s.get("status") == "open"]
    print(f"suspects: {len(ss)}  open={len(os_)} "
          f"(high-priority open: {[s.get('id') for s in os_ if s.get('priority')=='high']})")


