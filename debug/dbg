def main():
    ap = argparse.ArgumentParser(prog="dbg", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add_json(p):
        p.add_argument("--json", action="store_true", help="raw JSON output")

    p = sub.add_parser("episodes"); add_json(p); p.set_defaults(fn=cmd_episodes)

    p = sub.add_parser("hypotheses"); p.add_argument("episode")
    p.add_argument("--status", choices=["open", "closed", "all", *HYP_STATUSES])
    p.add_argument("--closed", action="store_true")
    p.add_argument("-v", "--verbose", action="store_true"); add_json(p)
    p.set_defaults(fn=cmd_hypotheses)

    p = sub.add_parser("suspects"); p.add_argument("episode")
    p.add_argument("--status", choices=["all", *SUS_STATUSES])
    p.add_argument("--open", action="store_true", help="only remaining OPEN suspects")
    p.add_argument("-v", "--verbose", action="store_true"); add_json(p)
    p.set_defaults(fn=cmd_suspects)

    p = sub.add_parser("evidence"); p.add_argument("episode")
    p.add_argument("--hypothesis"); add_json(p); p.set_defaults(fn=cmd_evidence)

    p = sub.add_parser("history", help="query the read-only append-only event journal")
    p.add_argument("episode")
    p.add_argument("--kind", action="append", help="event kind (repeatable)")
    p.add_argument("--hypothesis", help="hypothesis id or slug")
    p.add_argument("--suspect", help="suspect id or slug")
    p.add_argument("--since-seq", type=int, help="include events at or after this seq")
    p.add_argument("--until-seq", type=int, help="include events at or before this seq")
    p.add_argument("-v", "--verbose", action="store_true"); add_json(p)
    p.set_defaults(fn=cmd_history)

    p = sub.add_parser("show"); p.add_argument("episode"); p.add_argument("id")
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("changed", help="what changed in state since the notebook was last synced")
    p.add_argument("episode"); add_json(p); p.set_defaults(fn=cmd_changed)

    p = sub.add_parser("notebook", help="print the curated NOTEBOOK.md")
    p.add_argument("episode"); p.set_defaults(fn=cmd_notebook)

    p = sub.add_parser("vcs-check", help="list git-ignored paths (not on a fresh clone) for VCS_MISSING.md")
    p.add_argument("episode"); add_json(p); p.set_defaults(fn=cmd_vcs_check)

    p = sub.add_parser("notebook-sync", help="snapshot state as the notebook baseline (after revising NOTEBOOK.md)")
    p.add_argument("episode"); p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_notebook_sync)

    p = sub.add_parser("summary"); p.add_argument("episode"); add_json(p)
    p.set_defaults(fn=cmd_summary)

    p = sub.add_parser("new-episode"); p.add_argument("slug")
    p.add_argument("--title"); p.add_argument("--question"); p.add_argument("--owner")
    p.set_defaults(fn=cmd_new_episode)

    p = sub.add_parser("add-hypothesis"); p.add_argument("episode")
    p.add_argument("--id", required=True); p.add_argument("--statement", required=True)
    p.add_argument("--reasoning"); p.add_argument("--predicted"); p.add_argument("--owner")
    p.set_defaults(fn=cmd_add_hypothesis)

    p = sub.add_parser("set-hypothesis"); p.add_argument("episode"); p.add_argument("id")
    p.add_argument("--status"); p.add_argument("--verdict")
    p.set_defaults(fn=cmd_set_hypothesis)

    p = sub.add_parser("add-suspect"); p.add_argument("episode")
    p.add_argument("--sha", required=True); p.add_argument("--subject", required=True)
    p.add_argument("--subsystem"); p.add_argument("--date"); p.add_argument("--files")
    p.add_argument("--interval"); p.add_argument("--priority", choices=["high", "medium", "low"])
    p.add_argument("--reasoning"); p.set_defaults(fn=cmd_add_suspect)

    p = sub.add_parser("set-suspect"); p.add_argument("episode"); p.add_argument("id")
    p.add_argument("--status"); p.add_argument("--reasoning")
