[Unit]
Description=Hourly relay of alignment_reminder_prompt.md to the ORC coordinator pane
Documentation=https://github.com/rrnewton/dev-hermit/blob/main/scripts/alignment-reminder-relay.sh

[Service]
Type=oneshot
ExecStart=/home/newton/work/dev-hermit/scripts/alignment-reminder-relay.sh
# The driver already swallows delivery failures and exits 0; this is belt-and-
# braces so a future edit cannot put the unit into a failed state, which is the
# state from which a schedule quietly stops being useful.
SuccessExitStatus=0 1
