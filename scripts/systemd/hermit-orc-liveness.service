[Unit]
Description=External ORC liveness watchdog (detects a dead ORC that no ORC-hosted monitor can)
Documentation=https://github.com/rrnewton/dev-hermit/blob/main/scripts/orc-liveness-watchdog.rs

# Deliberately NO After=/Requires= on anything ORC-related. This unit must be
# able to run precisely when ORC is gone; binding it to ORC would recreate the
# shared-fate defect it exists to break.

[Service]
Type=oneshot
Environment=HOME=/home/newton
Environment=PATH=/home/newton/.cargo/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/newton/work/dev-hermit
ExecStart=/home/newton/work/dev-hermit/scripts/orc-liveness-watchdog.rs

# 0=LIVE, 1=DEAD, 2=UNKNOWN are all SUCCESSFUL RUNS of the watchdog -- the
# watchdog did its job and recorded a verdict. Only 3 (usage/internal error)
# is a unit failure. Letting a dead ORC mark this unit failed would be
# self-defeating: a failed unit is the state from which a schedule quietly
# stops being useful, so the alarm would silence itself exactly when it fires.
SuccessExitStatus=0 1 2

# First run after an edit compiles the rust-script from cold cache.
TimeoutStartSec=300

[Install]
WantedBy=default.target
