#!/bin/sh
# Publish local-only parent commits immediately after any parent commit.
#
# An unpushed commit emits no error, no failing check and no wakeup. On
# 2026-08-06 a local-main rewrite orphaned 45 of them, recovered only by an
# accidental fsck sweep. The tick-hub timer catches this within 15 minutes;
# this hook closes the window to seconds.
#
# DETECT AND PUBLISH ONLY: never merges, resets, rewrites, gcs, prunes,
# expires a reflog, repacks or cleans. Its only mutation is creating new
# remote refs under rescue/, which cannot destroy anything.
#
# Backgrounded and unconditionally exit 0, so it can never fail a commit or
# slow one down. Opt out with HERMIT_SKIP_UNPUSHED_RESCUE=1.
#
# ---------------------------------------------------------------------------
# TWO BOUNDS BELOW, ADDED 2026-08-08 AFTER THIS HOOK WEDGED THE PARENT WRITER.
#
# Backgrounding detached this hook from the commit's EXIT STATUS but not from
# its FILE DESCRIPTORS, and that distinction is the whole bug.
#
# scripts/parent-main-write holds the serialized parent-main writer lock as
# `exec 9>LOCK; flock 9` and exports HERMIT_PARENT_MAIN_LOCK_FD=9. A POSIX flock
# belongs to the OPEN FILE DESCRIPTION, not to the process that took it, so the
# kernel releases it only when the LAST inheriting fd closes. The orphan spawned
# below inherited fd 9; parent-main-write then exited and the commit was
# reported done, yet the lock stayed held for minutes while herdr-run pushed.
# Observed in /proc/locks: inode 50901671 still WRITE-locked with its recorded
# owner PID already gone and four serialized writers queued behind it, the
# longest waiting 5m30s. It blocked the day's most important change from
# publishing.
#
# 1. CLOSE THE INHERITED LOCK FD -- severs the inheritance vector, which is the
#    actual defect. Keyed on the exported variable rather than a literal 9 so it
#    tracks the writer; if that variable is absent or malformed we close nothing
#    rather than closing an fd we do not own.
# 2. HARD CEILING ON THE MUTATION -- a rescue is a PUSH, not an observation, and
#    an unbounded background mutation that no one is waiting on is precisely
#    what a hook must not launch. This bounds any residual leak and bounds the
#    mutation. Deliberately generous: this path may be slow, not unbounded.
# ---------------------------------------------------------------------------
[ -n "$HERMIT_SKIP_UNPUSHED_RESCUE" ] && exit 0
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -x "$root/ci-hub/health/unpushed_parent_commits.py" ] || exit 0

ceiling=${HERMIT_UNPUSHED_RESCUE_CEILING_SECS:-240}

close_lock_fd=':'
case "${HERMIT_PARENT_MAIN_LOCK_FD:-}" in
  '' | *[!0-9]*) ;;
  *) close_lock_fd="exec ${HERMIT_PARENT_MAIN_LOCK_FD}>&-" ;;
esac

(
  eval "$close_lock_fd"
  timeout --signal=TERM --kill-after=30 "$ceiling" \
    "$root/ci-hub/health/unpushed_parent_commits.py" --scope all --rescue \
    >> "$root/ignored/unpushed-parent-rescue.log" 2>&1 &
) >/dev/null 2>&1
exit 0
