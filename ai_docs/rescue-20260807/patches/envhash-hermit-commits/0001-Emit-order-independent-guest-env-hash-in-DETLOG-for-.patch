index 89faa5708..9bcfab060 100644
--- a/detcore/src/lib.rs
+++ b/detcore/src/lib.rs
@@ -98,6 +98,7 @@ use reverie::Tid;
 use reverie::TimerSchedule;
 use reverie::Tool;
 pub use reverie::process::Namespace;
