+SELECTIVE_BASELINE=$parent
+resolved=$(resolve_quiet)
+[[ $resolved == "$parent"$'\texplicit --baseline (caller asserts green)' ]] ||
+    die "explicit ancestor baseline was not honored: $resolved"
