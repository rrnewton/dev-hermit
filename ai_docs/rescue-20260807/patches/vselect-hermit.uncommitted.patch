+    printf '%s\n' '[{"head":{"sha":"$label_sha"},"labels":[{"name":"locally-validated"}]}]'
+    ;;
+  *'/runs?'*)
+    printf '%s\n' '{"workflow_runs":[{"head_sha":"$ci_sha","conclusion":"success"}]}'
+    ;;
+  *) exit 1 ;;
+esac
+EOF
+    chmod +x "$mock_bin/gh"
+}
